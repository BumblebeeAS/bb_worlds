<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='led_beacon'>
    <!-- Static but with collision geometry — vehicles collide with it, the
         buoy itself doesn't bob. -->
    <static>true</static>

    <link name='buoy_base'>
      <pose>0 0 0.15 0 0 0</pose>
      <collision name='buoy_collision'>
        <geometry>
          <cylinder><radius>0.225</radius><length>0.30</length></cylinder>
        </geometry>
      </collision>
      <visual name='buoy_visual'>
        <geometry>
          <cylinder><radius>0.225</radius><length>0.30</length></cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.35 0.05 1</ambient>
          <diffuse>1.0 0.45 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>

    <link name='led_off'>
      <pose>0 0 0.365 0 0 0</pose>
      <visual name='led_off_visual'>
        <geometry>
          <cylinder><radius>0.05</radius><length>0.13</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>

    <joint name='led_off_fixed' type='fixed'>
      <parent>buoy_base</parent>
      <child>led_off</child>
    </joint>
  </model>
</sdf>
