<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>

  <model name='pipe_model'>
    <static>1</static>
    <link name='pipe_base_link'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>235.4152162093547</mass>
        <inertia>
          <ixx>533.8067881323725</ixx>
          <ixy>1.5948978886996961e-13</ixy>
          <ixz>-444.4643834093107</ixz>
          <iyy>1033.1685999307199</iyy>
          <iyz>2.3032939573935558e-13</iyz>
          <izz>504.90262862240178</izz>
        </inertia>
      </inertial>
     
      <collision name='pipe_base_link_collision'>
        <pose>0 0 0 1.57 0 0</pose>
        <geometry>
         <mesh>
            <uri>model://robotx26/pipe_task/pipe_task_var3/meshes/pipe.glb</uri>
            <scale>1.0 1.0 1.0</scale>
        </mesh>
        </geometry>
      </collision>

      <visual name='pipe_base_visual'>
         <pose> 0 0 0 1.57 0 0 </pose>
            <geometry>
            <mesh>

            <uri>model://robotx26/pipe_task/pipe_task_var3/meshes/pipe.glb</uri>
            </mesh>

            </geometry>
      </visual>


    </link>



    <include>
      <name>pipe_led_1</name>
      <uri>model://robotx26/pipe_led</uri>
      <pose>1.08331 -1.08331 0.043369 1.57 0 0</pose>


    </include>

    <include>
      <name>pipe_led_2</name>
      <uri>model://robotx26/pipe_led</uri>
      <pose>0.68733 -0.39598 0.043369 1.57 0 0</pose>


    </include>

    <include>
      <name>pipe_led_3</name>
      <uri>model://robotx26/pipe_led</uri>
      <pose>0 0 0.043369 1.57 0 0</pose>

    </include>

    <include>
      <name>pipe_led_4</name>
      <uri>model://robotx26/pipe_led</uri>
      <pose>-0.68733 0.39598 0.043369 1.57 0 0</pose>

    </include>

    <include>
      <name>pipe_led_5</name>
      <uri>model://robotx26/pipe_led</uri>
      <pose>-1.37466 0.791 0.043369 1.57 0 0</pose>
    
    </include>

    <include>
      <name>pipe_buoy_left</name>
      <uri>model://robotx26/safe_passage_buoy</uri>
      <pose>-4 4 2 0 0 0</pose>
      <static>true</static>
    </include>
    <include>
      <name>pipe_buoy_right</name>
      <uri>model://robotx26/safe_passage_buoy</uri>
      <pose>4 -4 2 0 0 0</pose>
      <static>true</static>
    </include>


<plugin
      filename="libDistance_SensorSystem.so"
      name="Distance_Sensor::Distance_SensorSystem">
      <vehicle_name>auv5</vehicle_name>
      <target_name>pipe_led_1</target_name>
      <!-- Vehicle-local FLU offset -->
      <vehicle_offset_x>0.0</vehicle_offset_x>
      <vehicle_offset_y>0.0</vehicle_offset_y>
      <vehicle_offset_z>-0.1</vehicle_offset_z>
      <distance_threshold>0.3</distance_threshold>
      <minimum_time_within_threshold>1.0</minimum_time_within_threshold>
      <gz_subscribe_topic>/led_pipe_led_1/change_led_mode</gz_subscribe_topic>
      <trigger_condition>steady_red</trigger_condition>
      <output_topic>/led_pipe_led_1/change_led_mode</output_topic>
      <below_threshold_message>steady_green</below_threshold_message>
      <above_threshold_message>steady_red</above_threshold_message>
      <minimum_time_within_threshold>1.0</minimum_time_within_threshold>
    </plugin>

    <plugin
      filename="libDistance_SensorSystem.so"
      name="Distance_Sensor::Distance_SensorSystem">
      <vehicle_name>auv5</vehicle_name>
      <target_name>pipe_led_2</target_name>
