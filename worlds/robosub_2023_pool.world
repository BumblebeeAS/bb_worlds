<?xml version="1.0" ?>
<sdf version="1.11">
  <world name="robosub_2023_pool">
    <scene>
      <ambient>0.01 0.01 0.01 1.0</ambient>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>1</shadows>
    </scene>
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>0.5</sor>
        </solver>
      </ode>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <disable_on_drained_battery>true</disable_on_drained_battery>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>
    <plugin
      filename="gz-sim-forcetorque-system"
      name="gz::sim::systems::ForceTorque">
    </plugin>
    <plugin
      filename="gz-sim-particle-emitter-system"
      name="gz::sim::systems::ParticleEmitter">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>
    <scene>
      <ambient>0.1 0.3 0.3 1.0</ambient>
      <sky>
        <time>12</time>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>1</shadows>
      <!-- <fog>
        <color>0.1 0.2 0.2 1.0</color>
        <type>linear</type>
        <density>0.01</density>
      </fog> -->
      <grid>0</grid>
    </scene>
    <gui>
      <camera name="user_camera">
        <pose>3.726151 -53.194912 18.551052 0.0 0.467642 1.548197</pose>
      </camera>
    </gui>
    <!-- Origin placed at TRANSDEC -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>32.703406</latitude_deg>
      <longitude_deg>-117.250311</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- Global light source -->
    <light type="directional" name="sun1">
      <cast_shadows>false</cast_shadows>
      <pose>-20 -20 20 0 0 0</pose>
      <diffuse>0.2 0.2 0.8 1</diffuse>
      <specular>0 0 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.0 0.1 -0.9</direction>
    </light>

    <!-- <light type="directional" name="sun2">
      <cast_shadows>false</cast_shadows>
      <pose>20 -20 20 0 0 0</pose>
      <diffuse>0.1 0.5 0.5 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>40</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>5 0.1 -0.9</direction>
    </light> -->

    <!-- Bounding box with sea surface -->
    <include>
      <uri>model://transdec</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- TODO: fix broken obstacles -->
    <!-- <include>
      <uri>model://robosub23_gate</uri>
      <pose>12.679439 -23.700871 -2.079932 0 0 -0.846967</pose>
    </include>

    <include>
      <uri>model://robosub_bin_earth</uri>
      <name>bin_earth</name>
      <pose>28.322180 0.100706 -3.779856 0 0 0</pose>
    </include>

    <include>
      <uri>model://robosub_bin_abydos</uri>
      <name>bin_abydos</name>
      <pose>27.677107 0.100706 -3.779856 0 0 0</pose>
    </include> -->

    <!-- <include>
      <uri>model://robosub23_buoy_v1</uri>
      <pose>23.525951 -11.315313 -4.848698 0 0 -1.211361</pose>
    </include> -->

    <!-- <include>
      <uri>model://robosub23_torpedo_panel_v1 </uri>
      <pose>35.972866 -5.619069 -4.873676 0 0 -1.027005</pose>
    </include> -->

    <include>
      <name>cover_1</name>
      <uri>model://robosub_bin_cover</uri>
      <pose>28.350399 0.110008 -3.615128 0 0 0</pose>
    </include>

    <include>
      <name>cover_2</name>
      <uri>model://robosub_bin_cover</uri>
      <pose>27.687332 0.210735 -3.632456 0 0 0</pose>
    </include>

    <!-- <include>
      <uri>model://robosub23_octagon</uri>
      <pose>16.708937 22.320974 0 0 0 2.716391</pose>
    </include> -->

    <include>
      <name>chevron_1</name>
      <uri>model://robosub23_chevron</uri>
      <pose>16.700669 22.267581 -4.01600 3.141593 0 -2.238332</pose>
    </include>

    <include>
      <name>chevron_2</name>
      <uri>model://robosub23_chevron</uri>
      <pose>16.690139 22.411735 -4.05019 0 0 -0.582008</pose>
    </include>

    <include>
      <name>chevron_3</name>
      <uri>model://robosub23_chevron</uri>
      <pose>16.560148 22.277356 -4.01600 3.141593 0 -1.381260</pose>
    </include>
    <include>
      <name>chevron_4</name>
      <uri>model://robosub23_chevron</uri>
      <pose>16.834141 22.342808 -4.01600 3.141593 0 -1.381260</pose>
    </include>

    <include>
      <name>path_marker_1</name>
      <uri>model://path_marker</uri>
      <pose>25.539244 -10.14 -4.863491 0 0 1.369480</pose>
    </include>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Coast Water
      </uri>
    </include>

    <!-- This invisible plane helps with orbiting the camera, especially at large scales -->
    <plugin
      filename="gz-sim-buoyancy-system"
      name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>
    <plugin
      filename="gz-sim-dvl-system"
      name="gz::sim::systems::DopplerVelocityLogSystem">
    </plugin>
    <plugin
      filename="dave_ros_gz_plugins/libDVLBridge.so"
      name="dave_ros_gz_plugins::DVLBridge">
    </plugin>
  </world>
</sdf>
